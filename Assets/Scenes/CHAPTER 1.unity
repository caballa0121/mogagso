  - nameKeyword: "\uD0D0\uC0C9\uBCD1"
    animType: 1
    portraitObj: {fileID: 2143749517}
    rect: {fileID: 2143749520}
    image: {fileID: 2143749518}
    animSpeed: 3
    visiblePos: {x: 635, y: -53.002}
    hiddenPos: {x: 1550, y: -53.002}
    slot: 0
