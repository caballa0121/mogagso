  questUI: {fileID: 0}
  questText: {fileID: 0}
  instantSwapOnSameSlot: 1
  lines:
  - speaker: "\uD0D0\uC0C9\uBCD1"
    text: "\uC7A5\uAD50\uB2D8 \uACE7 \uBAA9\uD45C\uC9C0\uC810\uC5D0 \uB3C4\uB2EC\uD569\uB2C8\uB2E4."
  - speaker: "\uB178\uC544"
    text: "\uADF8\uB798 \uC740\uC2E0\uCC98 \uC548 \uB0B4\uBD80 \uC0C1\uD669\uC740
      \uC5B4\uB5A0\uC9C0?"
  - speaker: "\uD0D0\uC0C9\uBCD1"
    text: "\uC5F4\uC6D0 \uBC18\uC751 \uB2E4\uC218. \n\uC815\uD655\uD55C \uC778\uC6D0\uC740
      \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uBC18\uB780\uAD70\uC758
      \uAC70\uC13C \uC800\uD56D\uC774 \uC608\uC0C1\uB429\uB2C8\uB2E4."
  - speaker: "\uB178\uC544"
    text: "\uC800\uD56D\uD558\uBA74 \uC81C\uC555\uD55C\uB2E4. \uC804\uC6D0\uC5D0\uAC8C
      \uC804\uB2EC\uD574. \n\uBAA9\uD45C\uB294 \uBC18\uB780\uAD70\uC758 \uD655\uBCF4
      \uBC0F \uC740\uC2E0\uCC98\uC758 \uC644\uC804\uD55C \uC18C\uD0D5\uC774\uB2E4.\n"
