  - speakerName: B
    portraitSprite: {fileID: 21300000, guid: 4fc73ecb55bd34e4887e2c39c7ce41ac, type: 3}
    dialogueText: "\uC5EC\uAE30\uC11C \uBB50\uD574! \uC624\uB298 \uC6B0\uB9AC \uC9D1\uC5D0\uC11C
      \uB180\uAE30\uB85C \uD588\uC796\uC544!"
    cutsceneSprite: {fileID: 0}
    cutsceneBeforeLine: 0
  - speakerName: B
    portraitSprite: {fileID: 21300000, guid: 4fc73ecb55bd34e4887e2c39c7ce41ac, type: 3}
    dialogueText: "\uB204\uB098\uB3C4 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4 \uC5BC\uB978
      \uAC00\uC790!"
    cutsceneSprite: {fileID: 0}
    cutsceneBeforeLine: 0
  - speakerName: "\uC8FC\uC778\uACF5"
    portraitSprite: {fileID: 21300000, guid: ad5ba72a085bc4cb9ab5a6002f3dea90, type: 3}
    dialogueText: "...\uC54C\uACA0\uB2E4"
    cutsceneSprite: {fileID: 0}
    cutsceneBeforeLine: 0
  - speakerName: "\uC8FC\uC778\uACF5"
    portraitSprite: {fileID: 21300000, guid: ad5ba72a085bc4cb9ab5a6002f3dea90, type: 3}
    dialogueText: "(\uC774\uD574\uB418\uC9C0 \uC54A\uB294 \uAC83\uB4E4\uC774 \uD558\uB098
